# Lamèss — configurazione per cPanel (senza terminale). Copia come ".env" nella cartella dell'applicazione e compila i campi < >.
APP_NAME="Lamèss"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<il-tuo-dominio>
APP_LOCALE=it
APP_FALLBACK_LOCALE=it

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Database MySQL creato da cPanel → "Database MySQL"
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<prefisso_nomedb>
DB_USERNAME=<prefisso_utente>
DB_PASSWORD=<password-del-database>

# Su hosting condiviso: sessioni e cache su file, code "sync" (nessun worker), tutto il resto dal cron di cPanel
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Cookie di sessione solo su HTTPS (in produzione è già il valore predefinito)
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
# sync = email dentro la richiesta; database = in coda, le smaltisce il cron ogni minuto (vedi docs/messa-online.md)
QUEUE_CONNECTION=sync

# Posta: resta bloccata finché non si accende da Impostazioni di sistema (LAMESS_MAIL_ENABLED)
MAIL_MAILER=smtp
MAIL_HOST=<smtp-del-provider>
MAIL_PORT=587
MAIL_USERNAME=<utente-posta>
MAIL_PASSWORD=<password-posta>
MAIL_FROM_ADDRESS="noreply@<il-tuo-dominio>"
MAIL_FROM_NAME="${APP_NAME}"
LAMESS_MAIL_ENABLED=false
# Firma della Lettera di Incarico: «email» = codice OTP inviato per email (serve LAMESS_MAIL_ENABLED=true e l'SMTP); «fake» solo in sviluppo
LAMESS_SIGNATURE_DRIVER=email

# Sito chiuso al pubblico (pagina «Lamèss apre presto») finché non lo apri da Impostazioni di sistema → Sito.
# In alternativa metti true qui per aprirlo da file. Il back-office (/admin) funziona sempre.
LAMESS_SITE_OPEN=false

# Sicurezza
ADMIN_2FA_REQUIRED=true
# Token usato UNA volta dalla pagina /installazione (almeno 24 caratteri casuali). Cancellare la riga a installazione finita.
LAMESS_INSTALL_TOKEN=
# Facoltativa: chiave del log di audit separata da APP_KEY. Se cambia, il log precedente non è più verificabile.
LAMESS_AUDIT_KEY=
# Solo se il log contiene righe importate da un altro ambiente: chiave con cui sono firmate e id dell'ultima riga importata (vedi docs/messa-online.md)
# LAMESS_AUDIT_KEY_PREVIOUS=
# LAMESS_AUDIT_KEY_PREVIOUS_UNTIL=
